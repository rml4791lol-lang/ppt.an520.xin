{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "htmlppt/deck.schema.json",
 "title": "htmlppt/deck@1",
 "type": "object",
 "required": [
  "schema",
  "deck_id",
  "canvas",
  "theme",
  "pages"
 ],
 "properties": {
  "schema": {
   "const": "htmlppt/deck@1"
  },
  "deck_id": {
   "type": "string"
  },
  "canvas": {
   "type": "object",
   "required": [
    "w",
    "h"
   ],
   "properties": {
    "w": {
     "const": 1280
    },
    "h": {
     "const": 720
    }
   }
  },
  "theme": {
   "type": "string"
  },
  "masters": {
   "type": "array",
   "items": {
    "type": "string"
   }
  },
  "pages": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "id",
     "layout",
     "source"
    ],
    "properties": {
     "id": {
      "type": "string"
     },
     "layout": {
      "type": "string",
      "pattern": "^S\\d{2}$"
     },
     "source": {
      "type": "string",
      "pattern": "^(spec:S\\d{2}|fill|patch)$"
     },
     "title": {
      "type": "string"
     },
     "theme_slots": {
      "type": "array",
      "items": {
       "type": "string"
      }
     },
     "content_ref": {
      "type": "string"
     }
    }
   }
  }
 }
}