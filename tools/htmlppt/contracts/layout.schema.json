{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "htmlppt/layout.schema.json",
 "title": "htmlppt/layout@1",
 "type": "object",
 "required": [
  "id",
  "name",
  "slots"
 ],
 "properties": {
  "id": {
   "type": "string",
   "pattern": "^S\\d{2}$"
  },
  "name": {
   "type": "string"
  },
  "master": {
   "type": [
    "string",
    "null"
   ]
  },
  "part": {
   "type": "string"
  },
  "slots": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "name",
     "type",
     "x",
     "y",
     "w",
     "h"
    ],
    "properties": {
     "name": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "w": {
      "type": "number"
     },
     "h": {
      "type": "number"
     },
     "sz_pt": {
      "type": [
       "number",
       "null"
      ]
     },
     "sample": {
      "type": "string"
     },
     "required": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "capacity": {
      "type": [
       "object",
       "null"
      ]
     }
    }
   }
  }
 }
}