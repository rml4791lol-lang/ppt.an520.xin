# ---- 基础 ----
# sqlite 数据库文件路径（默认 <项目>/data/anppt-v2.db）
# ANPPT_V2_DB_PATH=

# 公开访问地址（用于支付回调、canonical、sitemap 和分享卡片，生产必填）
# PUBLIC_BASE_URL=https://ppt.an520.xin

# 页脚展示的运营主体与 ICP 备案号；没有 ICP 时留空，不会渲染空链接
# ANPPT_COMPANY_NAME=AnPPT
# ANPPT_ICP_NUMBER=

# session 有效期（毫秒，默认 30 天）
# ANPPT_SESSION_TTL_MS=2592000000

# Cookie Secure：true 总是 / false 从不 / 默认按请求协议自动
# ANPPT_COOKIE_SECURE=

# ---- 邮箱 OTP ----
# OTP 标识哈希的 HMAC 密钥（生产必填；不填则生产环境 OTP 不可用，本地用派生的开发密钥）
# ANPPT_OTP_HMAC_SECRET=

# 开发调试：非 production 下设为 true 时，OTP 接口直接回显验证码（不发邮件）
OTP_DEV_ECHO=true

# SMTP（QQ 邮箱示例：host=smtp.qq.com port=465，PASS 用授权码而非密码）
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# SMTP_USER=your@qq.com
# SMTP_PASS=your-smtp-auth-code
# SMTP_FROM=AnPPT <your@qq.com>   # 可带显示名；不设则地址回落 SMTP_USER。QQ：地址必须等于 SMTP_USER

# 阿里云短信（手机号验证码登录；不配则仅邮箱验证码可用）
# ALIYUN_SMS_ACCESS_KEY_ID=
# ALIYUN_SMS_ACCESS_KEY_SECRET=
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=

# 注册赠送积分（默认 100）
# SIGNUP_BONUS_CREDITS=100

# ---- 充值套餐 ----
# JSON 覆盖默认套餐：[{"id":"pack-500","label":"轻量创作包","amountFen":3990,"credits":500}]
# RECHARGE_PLANS=

# 订单待支付有效期（毫秒，默认 2 小时）
# RECHARGE_ORDER_TTL_MS=7200000

# ---- 微信支付（Native 扫码）----
# WECHAT_PAY_ENABLED=true
# 联调/无商户号时开 mock：下单返回假 code_url，回调接口接受 {"mock":1,...} 报文
# WECHAT_PAY_MOCK=true
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_SERIAL_NO=
# 商户 API 私钥：PEM 原文（可 hex）或文件路径二选一
# WECHAT_PAY_PRIVATE_KEY=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# 微信支付平台公钥：PEM 原文或文件路径二选一
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=
# WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
# 回调地址（默认 ${PUBLIC_BASE_URL}/api/recharge/notify/wechat）
# WECHAT_PAY_NOTIFY_URL=

# ---- epay 易支付（支付宝收银台）----
# EPAY_ENABLED=true
# EPAY_MOCK=true
# EPAY_GATEWAY=https://pay.example.com
# EPAY_PID=
# EPAY_KEY=
# 回调地址（默认 ${PUBLIC_BASE_URL}/api/recharge/notify/epay）
# EPAY_NOTIFY_URL=
# 支付完成回跳地址（默认 ${PUBLIC_BASE_URL}/?billing=success）
# EPAY_RETURN_URL=
# 默认支付类型 / 设备 / 是否走 mapi 下单（默认 alipay / jump / true）
# EPAY_DEFAULT_TYPE=alipay
# EPAY_DEVICE=jump
# EPAY_USE_MAPI=true

# ---- 计件价格（价源在 src/plugins/pricing，见 docs/PLUGIN-ARCHITECTURE.md §5）----
# JSON 整份覆盖默认价目：{"deck_page_generate":10,"deck_page_refine":5,"outline":0,"export_image":0,"export_editable":20,"export_editable_text":5,"ppt_to_base":5}；缺项 = 该动作未定价
# CREDIT_ACTION_PRICES=

# ---- 生成链（阶段 C，src/lib/server/generation/config.ts 读取）----
# 数据目录（上传/生成图/导出，默认 <项目>/data）
# ANPPT_V2_DATA_DIR=
# 上传大小上限（字节，默认 30MB）/ 文档内容截断（字，默认 100000）
# ANPPT_V2_UPLOAD_MAX_BYTES=31457280
# ANPPT_V2_SOURCE_TEXT_MAX_CHARS=100000
# PDF/DOCX 同时解析上限（默认 2）；排队超过 20 秒返回 503
# ANPPT_V2_DOCUMENT_PARSE_CONCURRENCY=2
# ANPPT_V2_DOCUMENT_PARSE_QUEUE_TIMEOUT_MS=20000

# PPT 引擎内部 API（大纲/内容梳理；不配置或不可达时走下方 LLM 兜底——兜底仅作灾备）
# PPT_ENGINE_BASE_URL=http://127.0.0.1:3002
# PPT_ENGINE_INTERNAL_TOKEN=

# 本地直连 LLM 兜底（OpenAI 兼容 /chat/completions；生产走 DeepSeek 官方，不用 PRO）
# ANPPT_V2_LLM_BASE_URL=https://api.deepseek.com/v1
# ANPPT_V2_LLM_API_KEY=
# ANPPT_V2_LLM_MODEL=deepseek-v4-flash
# ANPPT_V2_LLM_FALLBACK_MODELS=  # 空=不回退；逗号分隔最多 3 个
# ANPPT_V2_LLM_REASONING_EFFORT=low  # DeepSeek V4：low/high/max/off（off=关闭思考）
# LLM 跨站备份：主站全部模型失败后才尝试（三项须同时配置）
# ANPPT_V2_LLM_BACKUP_BASE_URL=
# ANPPT_V2_LLM_BACKUP_API_KEY=
# ANPPT_V2_LLM_BACKUP_MODEL=

# 生图上游（OpenAI 兼容 /images/generations + /images/edits）
# 主用 SSQ(squareface)：gpt-image-2（生成/编辑同名）。与 LLM 密钥分开，勿把 LLM 指到此站。
# ANPPT_V2_IMAGE_BASE_URL=https://api.sqface.sbs/v1
# ANPPT_V2_IMAGE_API_KEY=  # 可逗号分隔多把 key：逐请求轮转；401/402/403 的 key 按冷却窗口跳过（见 IMAGE_KEY_COOLDOWN_MS）
# ANPPT_V2_IMAGE_MODEL=gpt-image-2
# 改图专用模型（不配则与 IMAGE_MODEL 相同；分模型名的渠道必须配）
# image2.5 规范档名：gpt-image-2.5-sunburst（精准编辑，默认推荐）/ gpt-image-2.5-flare（快速档）
# ANPPT_V2_IMAGE_EDIT_MODEL=
# 灾备站（跨站）：站点按单价升序尝试，失败（402/401/403/429/5xx/超时/网络）切下一站；三项齐备才启用，BACKUP_EDIT_MODEL 不配则与 BACKUP_MODEL 同
# 2026-10-29 起生产用灵可/lk 中转（tyue 面板发 key）：OpenAI 兼容 /images/generations + /images/edits，同步返回；
# key 侧只勾选 tt-image-2.5 线路（在线两条：0.0313 / 0.0455 算力每张），余额有限，用完需充值或换回 atlascloud。
# ANPPT_V2_IMAGE_BACKUP_BASE_URL=https://api.lk888.ai/v1
# ANPPT_V2_IMAGE_BACKUP_API_KEY=
# ANPPT_V2_IMAGE_BACKUP_MODEL=tt-image-2.5
# ANPPT_V2_IMAGE_BACKUP_EDIT_MODEL=tt-image-2.5
# 备选：atlascloud 直连是异步预测 API，BASE_URL 指到 /api/v1，模型名带 /text-to-image 与 /edit 后缀（约 ¥1/张）
# ANPPT_V2_IMAGE_BACKUP_BASE_URL=https://api.atlascloud.ai/api/v1
# ANPPT_V2_IMAGE_BACKUP_MODEL=openai/gpt-image-2/text-to-image
# ANPPT_V2_IMAGE_BACKUP_EDIT_MODEL=openai/gpt-image-2/edit
# 第二灾备站（可选）：与 BACKUP_* 同口径，三项齐备才入池；站点顺序 = 已配单价升序，未配单价的站按配置顺序排最后
# ANPPT_V2_IMAGE_BACKUP2_BASE_URL=
# ANPPT_V2_IMAGE_BACKUP2_API_KEY=
# ANPPT_V2_IMAGE_BACKUP2_MODEL=
# ANPPT_V2_IMAGE_BACKUP2_EDIT_MODEL=
# ANPPT_V2_IMAGE_SIZE=1536x864
# ANPPT_V2_IMAGE_TIMEOUT_MS=480000

# 单套逐页并发（默认 6）；全站最大在途 20；滚动一分钟最多启动 24 次
# ANPPT_V2_GENERATE_CONCURRENCY=6
# ANPPT_V2_IMAGE_GLOBAL_CONCURRENCY=20
# ANPPT_V2_IMAGE_STARTS_PER_MINUTE=24
# 单用户公平调度：最多 6 个在途、每分钟最多启动 16 次
# ANPPT_V2_IMAGE_PER_USER_CONCURRENCY=6
# ANPPT_V2_IMAGE_STARTS_PER_USER_PER_MINUTE=16
# 仅 429/5xx/网络抖动后台恢复，默认最多 2 次，指数退避从 2 秒开始
# ANPPT_V2_IMAGE_MAX_RETRIES=2
# ANPPT_V2_IMAGE_RETRY_BASE_MS=2000
# 死 key（401/402/403）冷却窗口 ms，默认 600000（10 分钟）；0 = 关闭冷却。冷却期内所有请求跳过该 key，成功即清除、到期自动恢复
# ANPPT_V2_IMAGE_KEY_COOLDOWN_MS=600000
# 单页生成/改图单价（🌟/张，pricing 插件读取；独立于 CREDIT_ACTION_PRICES 整份覆盖）
# ANPPT_V2_SINGLE_PAGE_CREDITS=10
# 生成 job 心跳卡死判定阈值 ms（默认 max(5min, 生图超时+2min)；超过即视为进程中断，懒恢复收敛）
# ANPPT_V2_JOB_STALE_MS=
# 项目保留天数（UI 文案透出，默认 7；删除软删，超期后项目列表访问时物理清理行与生成图）
# ANPPT_V2_PROJECT_RETENTION_DAYS=7

# Codia 开放 API（转可编辑 PPTX 上游，pdf_to_ppt，20🌟/页；不配置则该功能不可用）
# ANPPT_V2_CODIA_API_KEY=
# ANPPT_V2_CODIA_BASE_URL=https://openapi.codia.ai

# 可编辑转换主通道：codia / image2ppt / auto / wps（wps 优先免费 WPS，失败回退 Image2PPT/Codia）
# ANPPT_V2_EDITABLE_PROVIDER=wps
# ANPPT_V2_IMAGE2PPT_API_KEY=
# ANPPT_V2_IMAGE2PPT_BASE_URL=https://image2ppt.com
# ANPPT_V2_IMAGE2PPT_WEBHOOK_SECRET=whsec_...
# 回调地址固定为 ${PUBLIC_BASE_URL}/api/webhooks/image2ppt；本地 HTTP 不传 callback，靠轮询。

# WPS AIPPT 图片/PDF 转 PPT（网页内部接口，非公开 API；仅限账号本人或已获授权使用；Cookie 只放服务端，禁止提交）
# 从已登录 WPS 会话复制 .wps.cn 域 Cookie，拼成一行 Cookie 请求头（至少含 wps_sid / kso_sid / uid）
# ANPPT_V2_WPS_AIPPT_COOKIE=
# ANPPT_V2_WPS_AIPPT_BASE_URL=https://ippt.wps.cn
# ANPPT_V2_WPS_AIPPT_TIMEOUT_MS=300000

# 上游成本估算单价（单位：分；仅影响 /api/admin/finance 的金额估算列，不配则只记真实单位）
# LLM 按每百万 tokens 计：输入/输出分开；BACKUP_ 前缀作用于跨站备份站
# ANPPT_V2_COST_LLM_INPUT_FEN_PER_MTOK=
# ANPPT_V2_COST_LLM_OUTPUT_FEN_PER_MTOK=
# ANPPT_V2_COST_LLM_BACKUP_INPUT_FEN_PER_MTOK=
# ANPPT_V2_COST_LLM_BACKUP_OUTPUT_FEN_PER_MTOK=
# 生图按次计（generations/edits 同价口径；squareface gpt-image-2 $0.05/张，平台额度 1$=¥1 ≈ 5 分）
# 三站单价同时决定尝试顺序：已配单价升序在前，未配置（0 = 未知）的站按配置顺序排最后
# ANPPT_V2_COST_IMAGE_FEN_PER_CALL=
# 生图灾备按次计（atlascloud 约 ¥1/张 = 100 分）
# ANPPT_V2_COST_IMAGE_BACKUP_FEN_PER_CALL=
# 生图第二灾备按次计
# ANPPT_V2_COST_IMAGE_BACKUP2_FEN_PER_CALL=
# Codia 转换按任务计
# ANPPT_V2_COST_CODIA_FEN_PER_CALL=
# Image2PPT 转换按页计（分/页；仅财务估算，不影响用户扣星）
# ANPPT_V2_COST_IMAGE2PPT_FEN_PER_PAGE=

# 管理员后台运行时配置加密主密钥（至少 32 字符；只放生产 .env，绝不提交真实值）
# ANPPT_V2_ADMIN_CONFIG_KEY=
