[Unit]
Description=AnPPT v2 (Next.js full-stack, ppt.an520.xin)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/anppt-v2/current
Environment=NODE_ENV=production
EnvironmentFile=/opt/anppt-v2/shared/.env
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3100 -H 127.0.0.1
Restart=always
RestartSec=3
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
